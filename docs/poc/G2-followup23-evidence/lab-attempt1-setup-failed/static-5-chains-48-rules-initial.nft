destroy table inet fvpn
add table inet fvpn
add chain inet fvpn fv0 { type filter hook input priority 0; policy accept; }
add chain inet fvpn fv1 { type filter hook output priority 0; policy accept; }
add chain inet fvpn fv2 { type filter hook forward priority 0; policy accept; }
add chain inet fvpn fv3 { type filter hook prerouting priority 0; policy accept; }
add chain inet fvpn fv4 { type filter hook postrouting priority 0; policy accept; }
add set inet fvpn fvmarker { type integer; }
add element inet fvpn fvmarker { 1 }
add counter inet fvpn fvcount0
