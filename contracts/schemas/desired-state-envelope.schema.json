        "issued_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
          "type": "string"
        },
        "job_id": {
          "format": "uuid",
          "type": "string"
        },
        "manifest_sha256": {
          "description": "SHA-256 of the canonical JSON of the manifest envelope.",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "manifest_url": {
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^https://",
          "type": "string"
        },
        "node_id": {
          "format": "uuid",
          "type": "string"
        },
        "publication_intent": {
          "$ref": "#/$defs/PublicationIntent"
