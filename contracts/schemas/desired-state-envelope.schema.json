        "incarnation_id",
        "batch_id",
        "target_id",
        "job_id",
        "attempt",
        "generation",
        "release_id",
        "manifest_url",
        "manifest_sha256",
        "issued_at",
        "authorization_valid_until",
        "publication_intent"
