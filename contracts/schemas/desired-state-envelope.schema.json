    "Signature": {
      "additionalProperties": false,
      "description": "One Ed25519 signature over the RFC 8785 canonical JSON of the envelope's\n`signed` object (§13.3, §16.2, `pkg/envelope`). Verifiers reject unknown\nalgorithms, ignore unknown key_ids, and require at least one valid\nsignature by a key trusted for the document's purpose.\n",
      "properties": {
        "algorithm": {
