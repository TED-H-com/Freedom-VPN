        "key_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "signature_b64": {
          "description": "Standard padded base64 of the 64-byte signature.",
          "pattern": "^[A-Za-z0-9+/]{86}==$",
          "type": "string"
        }
