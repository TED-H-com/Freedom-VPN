  "$id": "urn:fvpn:contracts:schema:desired-state-envelope:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Signed desired state (§14.7, §16.2). Signed with a `desired-state` purpose\nkey. The agent verifies the envelope, then that node_id and\nnode_incarnation_id equal its own identity, that config_generation is not\nolder than the last accepted one, and that `issued_at <= now <\nexpires_at`. An expired or unverifiable desired state turns member\nforwarding off and keeps the control channel (fail closed).\n",
  "properties": {
    "signatures": {
      "items": {
        "$ref": "#/$defs/Signature"
      },
      "maxItems": 8,
      "minItems": 1,
      "type": "array"
    },
    "signed": {
      "$ref": "#/$defs/DesiredState"
    }
  },
  "required": [
    "signed",
    "signatures"
  ],
  "title": "DesiredStateEnvelope",
  "type": "object"
}
