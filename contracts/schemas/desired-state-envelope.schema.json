      "additionalProperties": false,
      "description": "Authorized update job delivered through desired state (§13.10.2). The URL is\ntransport only; manifest_sha256 and release_id bind the job, and the\nmanifest is verified after download. The job must still be valid before a\ntransaction starts; after it starts the journal governs safe completion.\n",
      "properties": {
        "attempt": {
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
