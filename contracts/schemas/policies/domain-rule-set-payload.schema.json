{
  "$comment": "Derived from contracts/openapi.yaml component DomainRuleSetPayload (§12.4, §14.2); promoted to contracts/schemas/policies/domain-rule-set-payload.schema.json.",
  "$defs": {
    "DomainRule": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "block",
            "allow"
          ],
          "type": "string"
        },
        "domain": {
          "description": "Normalized ASCII domain name (lowercase, no trailing dot, Punycode IDNA 2008, no wildcards or regex).",
          "maxLength": 253,
          "minLength": 1,
          "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)*[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
          "type": "string"
        },
        "include_subdomains": {
          "description": "True means `domain` and every `*.domain`; false means exact match only.",
          "type": "boolean"
        },
        "profile_id": {
          "description": "Target profile code, or null for service-wide rules.",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Reason code, for example `admin_rule` or `false_positive`.",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "type": "string"
        },
        "revision": {
          "description": "Starts at 1 and increases forever (1..18446744073709551615, pkg/decstr).",
          "maxLength": 20,
          "pattern": "^([1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$",
          "type": "string"
        },
        "rule_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "profile_id",
        "domain",
        "include_subdomains",
        "action",
        "reason",
        "revision"
      ],
      "title": "DomainRule",
      "type": "object"
    }
  },
  "$id": "urn:fvpn:contracts:schema:domain-rule-set-payload:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Domain rule set payload (§12.4, §14.2).",
  "properties": {
    "rules": {
      "items": {
        "$ref": "#/$defs/DomainRule"
      },
      "maxItems": 100000,
      "type": "array"
    }
  },
  "required": [
    "rules"
  ],
  "title": "DomainRuleSetPayload",
  "type": "object"
}
