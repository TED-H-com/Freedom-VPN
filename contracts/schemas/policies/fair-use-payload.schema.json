{
  "$comment": "Derived from contracts/openapi.yaml component FairUsePayload (§11.1, §14.2). Candidate for promotion to contracts/schemas/.",
  "$defs": {
    "FairUseAccountingBasis": {
      "additionalProperties": false,
      "properties": {
        "measure": {
          "description": "Total is upload_bytes + download_bytes (§11.1).",
          "enum": [
            "total_bytes"
          ],
          "type": "string"
        },
        "metering_version": {
          "$ref": "#/$defs/MeteringVersion"
        },
        "period_type": {
          "description": "Pending business decision; v1 uses UTC calendar month.",
          "enum": [
            "utc_calendar_month"
          ],
          "type": "string"
        }
      },
      "required": [
        "period_type",
        "metering_version",
        "measure"
      ],
      "title": "FairUseAccountingBasis",
      "type": "object"
    },
    "FairUseOverride": {
      "additionalProperties": false,
      "description": "Time-limited, audited override for one member (§11.1, FUP04).",
      "properties": {
        "actor_id": {
          "format": "uuid",
          "type": "string"
        },
        "down_bps": {
          "format": "int64",
          "minimum": 0,
          "type": "integer"
        },
        "member_id": {
          "format": "uuid",
          "type": "string"
        },
        "priority": {
          "maximum": 7,
          "minimum": 0,
          "type": "integer"
        },
        "reason": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "up_bps": {
          "format": "int64",
          "minimum": 0,
          "type": "integer"
        },
        "valid_until": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
          "type": "string"
        }
      },
      "required": [
        "member_id",
        "down_bps",
        "up_bps",
        "priority",
        "valid_until",
        "reason",
        "actor_id"
      ],
      "title": "FairUseOverride",
      "type": "object"
    },
    "FairUseTier": {
      "additionalProperties": false,
      "description": "Speed tier entered when `threshold_bytes <= U < next_threshold_bytes` (§11.1). Thresholds and rates are TEST ONLY until business values are decided.",
      "properties": {
        "display_name": {
          "$ref": "#/$defs/LocalizedText"
        },
        "down_bps": {
          "description": "Bits per second, Internet to member.",
          "format": "int64",
          "minimum": 0,
          "type": "integer"
        },
        "priority": {
          "description": "HTB priority class; higher number means lower priority.",
          "maximum": 7,
          "minimum": 0,
          "type": "integer"
        },
        "threshold_bytes": {
          "description": "Inclusive lower bound of this tier. Tier 0 must be `\"0\"`.",
          "maxLength": 20,
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "up_bps": {
          "description": "Bits per second, member to Internet.",
          "format": "int64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "threshold_bytes",
        "down_bps",
        "up_bps",
        "priority",
        "display_name"
      ],
      "title": "FairUseTier",
      "type": "object"
    },
    "LocalizedText": {
      "additionalProperties": false,
      "description": "Display text in Traditional Chinese (`zh-TW`) and English (`en`).",
      "properties": {
        "en": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "zh-TW": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "zh-TW"
      ],
      "title": "LocalizedText",
      "type": "object"
    },
    "MeteringVersion": {
      "description": "Metering definition (§10.1). Never silently change the meaning of a version.",
      "enum": [
        "forward_admission_v1"
      ],
      "title": "MeteringVersion",
      "type": "string"
    },
    "RatePair": {
      "additionalProperties": false,
      "properties": {
        "down_bps": {
          "description": "Bits per second, Internet to member.",
          "format": "int64",
          "minimum": 0,
          "type": "integer"
        },
        "up_bps": {
          "description": "Bits per second, member to Internet.",
          "format": "int64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "down_bps",
        "up_bps"
      ],
      "title": "RatePair",
      "type": "object"
    }
  },
  "$id": "urn:fvpn:contracts:schema:fair-use-payload:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Fair-use policy payload (§11.1, §14.2).",
  "properties": {
    "accounting_basis": {
      "$ref": "#/$defs/FairUseAccountingBasis"
    },
    "effective_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "type": "string"
    },
    "effective_period": {
      "description": "New policy revisions take effect on the next period by default; immediate requires an explicit choice and audit (§11.5).",
      "enum": [
        "next_full_period",
        "immediate"
      ],
      "type": "string"
    },
    "minimum_rate": {
      "$ref": "#/$defs/RatePair"
    },
    "mode": {
      "enum": [
        "shadow",
        "enforce"
      ],
      "type": "string"
    },
    "overrides": {
      "items": {
        "$ref": "#/$defs/FairUseOverride"
      },
      "maxItems": 1000,
      "type": "array"
    },
    "tiers": {
      "items": {
        "$ref": "#/$defs/FairUseTier"
      },
      "maxItems": 16,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "mode",
    "effective_at",
    "effective_period",
    "accounting_basis",
    "tiers",
    "minimum_rate",
    "overrides"
  ],
  "title": "FairUsePayload",
  "type": "object"
}
