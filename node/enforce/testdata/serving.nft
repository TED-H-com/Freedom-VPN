# inet fvpn generation 7 forward_admission_v1
# §8.2 atomic transaction. Counters that already exist are not recreated (§10.7).
add table inet fvpn
add counter inet fvpn ctbadns
add counter inet fvpn ctbase
add counter inet fvpn ctdeny
add counter inet fvpn cthost
add counter inet fvpn ctin
add counter inet fvpn ctinv
add counter inet fvpn ctnodn
add counter inet fvpn ctunkd
add counter inet fvpn ctunku
add counter inet fvpn ctv6
add counter inet fvpn d_019a00000000700080000000000000a1
add counter inet fvpn d_019a00000000700080000000000000a2
add counter inet fvpn d_019a00000000700080000000000000b1
add counter inet fvpn nd_019a00000000700080000000000000a1
add counter inet fvpn nd_019a00000000700080000000000000a2
add counter inet fvpn nd_019a00000000700080000000000000b1
add counter inet fvpn nu_019a00000000700080000000000000a1
add counter inet fvpn nu_019a00000000700080000000000000a2
add counter inet fvpn nu_019a00000000700080000000000000b1
add counter inet fvpn u_019a00000000700080000000000000a1
add counter inet fvpn u_019a00000000700080000000000000a2
add counter inet fvpn u_019a00000000700080000000000000b1
add set inet fvpn allowed_v4 { type ipv4_addr; flags timeout; }
add set inet fvpn denied_v4 { type ipv4_addr; flags interval; auto-merge; }
add set inet fvpn host_v4 { type ipv4_addr; flags interval; auto-merge; }
add set inet fvpn resolver_v4 { type ipv4_addr; }
add element inet fvpn allowed_v4 { 100.64.1.1 timeout 3600s, 100.64.1.2 timeout 3600s, 100.64.2.1 timeout 3600s }
add element inet fvpn denied_v4 { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.0.2.128/25, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4, 255.255.255.255/32 }
add element inet fvpn host_v4 { 192.0.2.33/32, 192.0.2.37/32 }
add element inet fvpn resolver_v4 { 198.51.100.53 }
add chain inet fvpn forward { type filter hook forward priority -150; policy drop; }
add chain inet fvpn input { type filter hook input priority -150; policy accept; }
add chain inet fvpn output { type filter hook output priority -150; policy accept; }
add chain inet fvpn postrouting { type nat hook postrouting priority 100; policy accept; }
add rule inet fvpn forward ip saddr 192.0.2.255 ip daddr 192.0.2.255 comment "fvpn_generation=7 fvpn_metering=forward_admission_v1"
add rule inet fvpn forward ip saddr 192.0.2.255 ip daddr 192.0.2.255 comment "fvpn_class=019a0000-0000-7000-8000-00000000000a:2f"
add rule inet fvpn forward ip saddr 192.0.2.255 ip daddr 192.0.2.255 comment "fvpn_class=019a0000-0000-7000-8000-00000000000b:30"
add rule inet fvpn forward iifname "fv-fh" oifname "fv-ih" meta nfproto ipv6 counter name "ctv6" drop
add rule inet fvpn forward iifname "fv-ih" oifname "fv-fh" meta nfproto ipv6 counter name "ctv6" drop
add rule inet fvpn forward iifname "fv-fh" oifname "fv-ih" ct state invalid counter name "ctinv" drop
add rule inet fvpn forward iifname "fv-ih" oifname "fv-fh" ct state invalid counter name "ctinv" drop
add rule inet fvpn forward iifname "fv-fh" oifname "fv-ih" ip saddr != @allowed_v4 counter name "ctunku" drop
add rule inet fvpn forward iifname "fv-fh" oifname "fv-ih" ip saddr 100.64.1.1 ip daddr @resolver_v4 tcp dport 53 counter name "nu_019a00000000700080000000000000a1" meta priority set 0x0001002f accept
add rule inet fvpn forward iifname "fv-fh" oifname "fv-ih" ip saddr 100.64.1.1 ip daddr @resolver_v4 udp dport 53 counter name "nu_019a00000000700080000000000000a1" meta priority set 0x0001002f accept
add rule inet fvpn forward iifname "fv-fh" oifname "fv-ih" ip saddr 100.64.1.2 ip daddr @resolver_v4 tcp dport 53 counter name "nu_019a00000000700080000000000000a2" meta priority set 0x0001002f accept
