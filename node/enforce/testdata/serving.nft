add rule inet fvpn forward iifname "fv-ih" oifname "fv-fh" ip saddr @resolver_v4 ip daddr 100.64.2.1 udp sport 53 counter name "nd_019a00000000700080000000000000b1" meta priority set 0x00010030 accept
