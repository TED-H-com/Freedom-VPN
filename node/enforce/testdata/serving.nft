add rule inet fvpn forward iifname "fv-fh" oifname "fv-ih" ip daddr @host_v4 counter name "cthost" drop
add rule inet fvpn forward iifname "fv-fh" oifname "fv-ih" ip saddr 100.64.1.1 counter name "u_019a00000000700080000000000000a1" meta priority set 0x0001002f accept
add rule inet fvpn forward iifname "fv-fh" oifname "fv-ih" ip saddr 100.64.1.2 counter name "u_019a00000000700080000000000000a2" meta priority set 0x0001002f accept
add rule inet fvpn forward iifname "fv-fh" oifname "fv-ih" ip saddr 100.64.2.1 counter name "u_019a00000000700080000000000000b1" meta priority set 0x00010030 accept
