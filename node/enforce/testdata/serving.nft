add rule inet fvpn forward iifname "fv-fh" oifname "fv-ih" ip saddr 100.64.2.1 ip daddr @resolver_v4 tcp dport 53 counter name "nu_019a00000000700080000000000000b1" meta priority set 0x00010030 accept
