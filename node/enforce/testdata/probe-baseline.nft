# inet fvpn boot baseline. Member forwarding is off (§8.2).
add table inet fvpn
add counter inet fvpn ctbase
add counter inet fvpn ctv6
add counter inet fvpn ctin
add counter inet fvpn ctinv
add counter inet fvpn ctdeny
add counter inet fvpn cthost
add counter inet fvpn probe_up
add counter inet fvpn probe_down
add counter inet fvpn ctbadns
add set inet fvpn allowed_v4 { type ipv4_addr; flags timeout; }
add set inet fvpn denied_v4 { type ipv4_addr; flags interval; auto-merge; }
add set inet fvpn host_v4 { type ipv4_addr; flags interval; auto-merge; }
add set inet fvpn probe_v4 { type ipv4_addr; flags timeout; }
add set inet fvpn resolver_v4 { type ipv4_addr; }
add set inet fvpn probe_dst_v4 { type ipv4_addr . inet_proto . inet_service; flags timeout; }
add element inet fvpn denied_v4 { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.0.2.128/25, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4, 255.255.255.255/32 }
add element inet fvpn host_v4 { 192.0.2.33/32, 192.0.2.37/32 }
add element inet fvpn resolver_v4 { 198.51.100.53 }
add element inet fvpn probe_v4 { 100.64.8.1 timeout 30s }
add element inet fvpn probe_dst_v4 { 1.2.3.4 . tcp . 80 timeout 30s }
add chain inet fvpn forward { type filter hook forward priority -150; policy drop; }
add chain inet fvpn input { type filter hook input priority -150; policy accept; }
add chain inet fvpn output { type filter hook output priority -150; policy accept; }
add chain inet fvpn postrouting { type nat hook postrouting priority 100; policy accept; }
add rule inet fvpn forward ip saddr 192.0.2.255 ip daddr 192.0.2.255 comment "fvpn_generation=0 fvpn_baseline=1 fvpn_metering=forward_admission_v1"
add rule inet fvpn forward iifname "fv-fh" meta nfproto ipv6 counter name "ctv6" drop
add rule inet fvpn forward oifname "fv-fh" meta nfproto ipv6 counter name "ctv6" drop
add rule inet fvpn forward iifname "fv-fh" ct state invalid counter name "ctinv" drop
add rule inet fvpn forward oifname "fv-fh" ct state invalid counter name "ctinv" drop
add rule inet fvpn forward iifname "fv-fh" oifname "fv-ih" ip saddr @probe_v4 ip daddr @resolver_v4 tcp dport 53 counter name "probe_up" accept
add rule inet fvpn forward iifname "fv-fh" oifname "fv-ih" ip saddr @probe_v4 ip daddr @resolver_v4 udp dport 53 counter name "probe_up" accept
add rule inet fvpn forward iifname "fv-fh" oifname "fv-ih" ip daddr @resolver_v4 counter name "ctbadns" drop
add rule inet fvpn forward iifname "fv-fh" ip daddr @denied_v4 counter name "ctdeny" drop
add rule inet fvpn forward iifname "fv-fh" ip daddr @host_v4 counter name "cthost" drop
add rule inet fvpn forward iifname "fv-fh" oifname "fv-ih" ip saddr @probe_v4 ip daddr . meta l4proto . th dport @probe_dst_v4 counter name "probe_up" accept
add rule inet fvpn forward iifname "fv-ih" oifname "fv-fh" ip daddr @probe_v4 ct state established,related counter name "probe_down" accept
add rule inet fvpn forward iifname "fv-fh" counter name "ctbase" drop
add rule inet fvpn forward oifname "fv-fh" counter name "ctbase" drop
add rule inet fvpn input iifname "fv-fh" counter name "ctin" drop
add rule inet fvpn input ip saddr 100.64.0.0/10 counter name "ctin" drop
add rule inet fvpn postrouting oifname "fv-ih" ip saddr @probe_v4 snat ip to 192.0.2.37
