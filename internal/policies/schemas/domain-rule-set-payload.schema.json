{
  "$comment": "Derived from contracts/openapi.yaml component DomainRuleSetPayload (§12.4, §14.2). Candidate for promotion to contracts/schemas/.",
  "$defs": {
    "DomainRule": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "block",
            "allow"
          ],
          "type": "string"
        },
        "domain": {
          "description": "Normalized ASCII domain name (lowercase, no trailing dot, Punycode IDNA 2008, no wildcards or regex).",
          "maxLength": 253,
          "minLength": 1,
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$",
          "type": "string"
        },
        "include_subdomains": {
          "description": "True means `domain` and every `*.domain`; false means exact match only.",
          "type": "boolean"
        },
        "profile_id": {
          "description": "Target profile code, or null for service-wide rules.",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "revision": {
          "description": "Starts at 1 and increases forever.",
          "maxLength": 20,
          "pattern": "^[1-9][0-9]*$",
          "type": "string"
        },
        "rule_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "profile_id",
        "domain",
        "include_subdomains",
        "action",
        "reason",
        "revision"
      ],
      "title": "DomainRule",
      "type": "object"
    }
  },
  "$id": "urn:fvpn:contracts:schema:domain-rule-set-payload:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Domain rule set payload (§12.4, §14.2).",
  "properties": {
    "rules": {
      "items": {
        "$ref": "#/$defs/DomainRule"
      },
      "maxItems": 10000,
      "type": "array"
    }
  },
  "required": [
    "rules"
  ],
  "title": "DomainRuleSetPayload",
  "type": "object"
}
