{
  "$comment": "Derived from contracts/openapi.yaml component ThreatFeedPayload (§12.3, §14.2). Candidate for promotion to contracts/schemas/.",
  "$id": "urn:fvpn:contracts:schema:threat-feed-payload:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Threat feed source definition (§12.3, §14.2).",
  "properties": {
    "attribution": {
      "maxLength": 1000,
      "type": [
        "string",
        "null"
      ]
    },
    "categories": {
      "items": {
        "enum": [
          "malware",
          "phishing",
          "ads",
          "family"
        ],
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "commercial_use_basis": {
      "description": "Evidence that the feed license permits commercial SaaS/VPN use.",
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "feed_code": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "type": "string"
    },
    "format": {
      "enum": [
        "domain_list",
        "hosts",
        "adblock"
      ],
      "type": "string"
    },
    "license_name": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "license_url": {
      "format": "uri",
      "maxLength": 512,
      "pattern": "^https://",
      "type": "string"
    },
    "max_size_bytes": {
      "description": "Maximum download size accepted by the central compiler.",
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "provider": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "source_url": {
      "description": "Fixed HTTPS URL fetched only by the central worker, never by nodes.",
      "format": "uri",
      "maxLength": 512,
      "pattern": "^https://",
      "type": "string"
    },
    "update_interval_seconds": {
      "maximum": 604800,
      "minimum": 300,
      "type": "integer"
    },
    "valid_from": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "type": "string"
    },
    "valid_until": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "type": "string"
    }
  },
  "required": [
    "provider",
    "feed_code",
    "license_name",
    "license_url",
    "commercial_use_basis",
    "attribution",
    "source_url",
    "format",
    "categories",
    "content_sha256",
    "max_size_bytes",
    "valid_from",
    "valid_until",
    "update_interval_seconds"
  ],
  "title": "ThreatFeedPayload",
  "type": "object"
}
