# /etc/systemd/system/fvpn-backup-verify.service
# Daily isolated restore & schema/checklist verification of the latest backup (§17.2, AT30).
[Unit]
Description=Freedom VPN Central PostgreSQL Isolated Restore Verification
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/fvpn/secrets/pgbackrest-repo.env
ExecStartPre=/bin/sh -c 'test -n "$PGBACKREST_REPO1_CIPHER_PASS"'
ExecStart=/usr/local/lib/fvpn/backup/verify.sh --stanza fvpn --host-repo --primary-host --db-user postgres --migrate-bin /usr/local/bin/fvpn-migrate
NoNewPrivileges=true
Environment=FVPN_BACKUP_SCRATCH_ROOT=/var/lib/fvpn/backup-verify
# Disk storage visible to Docker bind mounts; never PrivateTmp or tmpfs.
PrivateTmp=false
