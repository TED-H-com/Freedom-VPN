[Unit]
Description=Freedom VPN update recovery
# §13.5: reconcile the updater journal before member services. Exit 2 means
# members stay blocked and is still a successful recovery.
After=local-fs.target
Before=fvpn-agent.service
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
SuccessExitStatus=0 2
ExecStart=/opt/vpn-node/current/fvpn-updater recover -config /etc/vpn-node/updater.json
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RuntimeDirectory=vpn-node
RuntimeDirectoryMode=0755
# Shared heartbeat/health paths must survive every consumer's stop/restart.
RuntimeDirectoryPreserve=yes
UMask=0077
ReadWritePaths=/var/lib/vpn-node /opt/vpn-node /run/vpn-node
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
