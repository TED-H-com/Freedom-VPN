[Unit]
Description=Freedom VPN node updater
# No NET_ADMIN and no NET_RAW. The updater writes files and asks systemd
# to stop and start the agent. It does not program nftables.
# The updater reads the kernel boot id; configured boot_id is fallback only.
After=network-online.target fvpn-netbird.service
Wants=network-online.target

[Service]
Type=oneshot
SuccessExitStatus=0 2
ExecStart=/opt/vpn-node/current/fvpn-updater run -config /etc/vpn-node/updater.json
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RuntimeDirectory=vpn-node
UMask=0077
ReadWritePaths=/var/lib/vpn-node /opt/vpn-node /run/vpn-node
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
