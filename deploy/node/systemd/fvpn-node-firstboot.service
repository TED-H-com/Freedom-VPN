[Unit]
Description=Freedom VPN first-boot enrollment
# A prepared image has no identity (§6.3, ENR03). The token file is placed
# by the operator at first boot and is not in the image.
ConditionPathExists=/var/lib/vpn-node/firstboot.token
ConditionPathExists=!/var/lib/vpn-node/identity/node.json
After=network-online.target
# Firstboot starts the member units synchronously after enrollment.
# Do not order this oneshot before those jobs: that would deadlock its start.
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/vpn-node/current/fvpn-node-install firstboot
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RuntimeDirectory=vpn-node
RuntimeDirectoryMode=0755
# Shared heartbeat/health paths must survive every consumer's stop/restart.
RuntimeDirectoryPreserve=yes
UMask=0077
ReadWritePaths=/var/lib/vpn-node /etc/vpn-node /run/vpn-node /etc/machine-id -/var/lib/dbus/machine-id
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
