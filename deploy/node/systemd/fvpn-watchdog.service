[Unit]
Description=Freedom VPN node watchdog
# Independent of the agent (§17.1, "Agent 卡住或退出"). No PartOf, BindsTo
# or Requires on fvpn-agent. CAP_NET_ADMIN only: the watchdog installs the
# nftables and tc baseline and does not open raw sockets.
After=network-online.target
# Reverse stop ordering keeps the watchdog alive through the agent's shutdown.
Before=fvpn-agent.service
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/opt/vpn-node/current/fvpn-watchdog run -config /etc/vpn-node/agent.json
Restart=on-failure
RestartSec=2s
RestartMaxDelaySec=30s
RestartSteps=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RuntimeDirectory=vpn-node
RuntimeDirectoryMode=0755
# Shared heartbeat/health paths must survive every consumer's stop/restart.
RuntimeDirectoryPreserve=yes
UMask=0077
ReadWritePaths=/var/lib/vpn-node /run/vpn-node
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
