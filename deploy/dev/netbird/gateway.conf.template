# TEST ONLY HTTP. Egress-free upstreams; never log query strings or credentials.
server {
    listen ${FVPN_NB_API_PORT};
    http2 on;
    server_name netbird.example.invalid;
    access_log off;
    error_log /dev/stderr crit;
    location / { proxy_pass http://dashboard:80; }
    location ~ ^/(api|oauth2|relay|ws-proxy) {
        proxy_pass http://server:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 1h;
    }
    location ~ ^/(management.ManagementService|signalexchange.SignalExchange)/ {
        grpc_pass grpc://server:8080;
        grpc_read_timeout 1h;
        grpc_send_timeout 1h;
    }
}
