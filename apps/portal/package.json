{
  "name": "@freedom-vpn/portal",
  "private": true,
  "version": "0.1.0",
  "description": "Freedom VPN Admin and Member Portal",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:stack": "node e2e/dev-stack.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.{ts,mjs}\" index.html vite.config.ts playwright.config.ts eslint.config.js",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.{ts,mjs}\" index.html vite.config.ts playwright.config.ts eslint.config.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.66.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.13.5",
    "@types/pg": "8.23.1",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "4.1.12",
    "axe-core": "4.10.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "16.0.0",
    "jsdom": "26.0.0",
    "msw": "2.7.3",
    "pg": "8.23.1",
    "prettier": "3.5.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.25.0",
    "vite": "6.4.5",
    "vitest": "4.1.12",
    "vitest-axe": "0.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
